{
  "hosting": {
    "public": "public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/ads.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/tool.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, no-cache, must-revalidate, max-age=0"
          },
          {
            "key": "Pragma",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/contact",
        "destination": "/about#contact",
        "type": 301
      },
      {
        "source": "/contact.html",
        "destination": "/about#contact",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/*/preview",
        "destination": "/tool.html"
      },
      {
        "source": "/*/download",
        "destination": "/tool.html"
      },
      {
        "source": "**",
        "destination": "/tool.html"
      }
    ]
  }
}
